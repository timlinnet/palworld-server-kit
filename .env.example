# Copy to .env on the server and fill in. Never commit .env.
#   cp .env.example .env

# Shown in the in-game community server list. Make it findable — your friends
# will be scrolling/searching for this exact string on their Xbox.
SERVER_NAME="My Palworld Server"
SERVER_DESCRIPTION="Private server — ask the host for the password"

# REQUIRED for a community server. Also what keeps randoms out, since a
# community server is publicly listed by definition.
SERVER_PASSWORD="change-me"

# Grants admin in-game AND is the REST API password (Basic auth, user "admin").
# Make this long and different from SERVER_PASSWORD.
ADMIN_PASSWORD="change-me-too"

# 1-32. 16 gives headroom over 10+ players without wasting RAM.
PLAYERS=16

TZ="America/New_York"
